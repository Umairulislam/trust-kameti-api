generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CommitteeStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum PayoutMethod {
  LOTTERY
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  INVITED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum CycleStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ContributionStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentMethod {
  EASYPAISA
  JAZZCASH
  BANK_TRANSFER
  OTHER
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AuditAction {
  COMMITTEE_CREATED
  COMMITTEE_UPDATED
  COMMITTEE_STATUS_CHANGED
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_REMOVED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  PAYMENT_SUBMITTED
  PAYMENT_RECEIPT_UPLOADED
  CONTRIBUTION_STATUS_CHANGED
  LOTTERY_EXECUTED
  PAYOUT_CREATED
  PAYOUT_STATUS_CHANGED
}

enum NotificationType {
  COMMITTEE_INVITATION
  COMMITTEE_STATUS_CHANGED
  CYCLE_STARTED
  CYCLE_COMPLETED
  CONTRIBUTION_REMINDER
  CONTRIBUTION_OVERDUE
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  LOTTERY_COMPLETED
  PAYOUT_COMPLETED
  GENERAL
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  committees   Committee[]
  memberships  CommitteeMember[]
  invitations  Invitation[]
  notifications Notification[]

  @@map("users")
}

model Committee {
  id                 String          @id @default(uuid())
  name               String
  description        String?
  contributionAmount Decimal         @db.Decimal(12, 2)
  memberLimit        Int
  totalCycles        Int
  payoutMethod       PayoutMethod    @default(LOTTERY)
  startDate          DateTime
  dueDay             Int
  status             CommitteeStatus @default(DRAFT)
  createdBy          String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  creator    User              @relation(fields: [createdBy], references: [id])
  members    CommitteeMember[]
  invitations Invitation[]
  cycles     Cycle[]
  notifications Notification[]

  @@map("committees")
}

model CommitteeMember {
  id          String       @id @default(uuid())
  committeeId String
  userId      String
  role        MemberRole   @default(MEMBER)
  status      MemberStatus @default(INVITED)
  joinedAt    DateTime?
  removedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  committee Committee @relation(fields: [committeeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  contributions Contribution[]
  lotteryWins   LotteryResult[]
  payouts      Payout[]

  @@unique([userId, committeeId])
  @@map("committee_members")
}

model Invitation {
  id          String           @id @default(uuid())
  committeeId String
  invitedBy   String
  email       String
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  committee Committee @relation(fields: [committeeId], references: [id])
  inviter   User      @relation(fields: [invitedBy], references: [id])

  @@map("invitations")
}

model Contribution {
  id        String             @id @default(uuid())
  cycleId   String
  memberId  String
  amount    Decimal            @db.Decimal(12, 2)
  dueDate   DateTime
  status    ContributionStatus @default(PENDING)
  paidAt    DateTime?
  paymentId String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  cycle  Cycle           @relation(fields: [cycleId], references: [id])
  member CommitteeMember @relation(fields: [memberId], references: [id])
  payments Payment[]

  @@unique([cycleId, memberId])
  @@map("contributions")
}

model Cycle {
  id            String      @id @default(uuid())
  committeeId   String
  cycleNumber   Int
  startDate     DateTime?
  endDate       DateTime?
  status        CycleStatus @default(UPCOMING)
  totalExpected Decimal     @default(0) @db.Decimal(12, 2)
  totalCollected Decimal    @default(0) @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  committee  Committee      @relation(fields: [committeeId], references: [id])
  contributions Contribution[]
  lotteryResult LotteryResult?
  payout         Payout?

  @@unique([committeeId, cycleNumber])
  @@map("cycles")
}

model Payment {
  id                   String        @id @default(uuid())
  contributionId       String
  memberId             String
  amount               Decimal       @db.Decimal(12, 2)
  transactionReference String
  paymentMethod        PaymentMethod?
  status               PaymentStatus @default(PENDING)
  paidAt               DateTime      @default(now())
  verifiedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  contribution Contribution @relation(fields: [contributionId], references: [id])

  receipt PaymentReceipt?

  @@map("payments")
}

model LotteryResult {
  id                  String   @id @default(uuid())
  cycleId             String   @unique
  winnerMemberId      String
  eligibleMemberCount Int
  executedAt          DateTime @default(now())
  executedBy          String
  createdAt           DateTime @default(now())

  cycle  Cycle           @relation(fields: [cycleId], references: [id])
  winner CommitteeMember @relation(fields: [winnerMemberId], references: [id])

  @@map("lottery_results")
}

model Payout {
  id        String       @id @default(uuid())
  cycleId   String       @unique
  memberId  String
  amount    Decimal      @db.Decimal(12, 2)
  status    PayoutStatus @default(PENDING)
  paidAt    DateTime?
  reference String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  cycle  Cycle           @relation(fields: [cycleId], references: [id])
  member CommitteeMember @relation(fields: [memberId], references: [id])

  @@map("payouts")
}

model AuditLog {
  id          String      @id @default(uuid())
  actorId     String
  action      AuditAction
  entityType  String
  entityId    String
  committeeId String?
  cycleId     String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([committeeId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  read        Boolean          @default(false)
  committeeId String?
  token       String?
  createdAt   DateTime         @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  committee Committee? @relation(fields: [committeeId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

model PaymentReceipt {
  id         String   @id @default(uuid())
  paymentId  String   @unique
  mimeType   String
  size       Int
  uploadedBy String
  uploadedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@map("payment_receipts")
}
